// ================= HANDLERS =================
void handleRoot(){
  server.sendHeader("Cache-Control","public, max-age=86400");
  server.send_P(200,"text/html",INDEX_HTML);
}

void handleSW(){
  server.sendHeader("Cache-Control","no-cache");
  server.send_P(200,"application/javascript",SW_JS);
}

void handleManifest(){
  server.send(200,"application/json",MANIFEST_JSON);
}

void handleCheck(){
  if(server.hasArg("p") && server.arg("p")==PASSWORD){
    sessionToken=generateToken();
    server.sendHeader(
      "Set-Cookie",
      "auth=" + sessionToken + "; Path=/; Max-Age=31536000; SameSite=Lax"
    );
    server.send(200,"text/plain","OK");
  } else server.send(403,"text/plain","NO");
}

void handleRelay(){
  if(!hasValidCookie()){ server.send(403,"text/plain","DENIED"); return; }

  int n=server.arg("num").toInt()-1;
  relayState[n]=!relayState[n];
  setRelay(n,relayState[n]);

  server.send(200,"application/json",
    String("{\"state\":")+ (relayState[n]?"true":"false") +"}");
}

void handleState(){
  String json="{";
  json+="\"r1\":"+(String)(relayState[0]?"true":"false")+ ",";
  json+="\"r2\":"+(String)(relayState[1]?"true":"false")+ ",";
  json+="\"r3\":"+(String)(relayState[2]?"true":"false")+ ",";
  json+="\"r4\":"+(String)(relayState[3]?"true":"false")+"}";
  server.send(200,"application/json",json);
}

void handleAuth(){
  if(hasValidCookie())
    server.send(200,"text/plain","OK");
  else
    server.send(403,"text/plain","NO");
}

// ================= SETUP =================
void setup(){
  pinMode(RELAY_1,OUTPUT);
  pinMode(RELAY_2,OUTPUT);
  pinMode(RELAY_3,OUTPUT);
  pinMode(RELAY_4,OUTPUT);

  pinMode(LED, OUTPUT);          // ===== ДОБАВЛЕНО =====
  digitalWrite(LED, HIGH);       // LED погашен

  WiFi.begin(ssid,wifi_password);
  randomSeed(ESP.getCycleCount());

  server.collectHeaders(headerKeys,headerKeysCount);

  server.on("/",handleRoot);
  server.on("/sw.js",handleSW);
  server.on("/manifest.json",handleManifest);
  server.on("/check",HTTP_POST,handleCheck);
  server.on("/relay",HTTP_POST,handleRelay);
  server.on("/state",handleState);
  server.on("/auth",handleAuth);

  server.begin();
}

// ================= LOOP =================
void loop(){
  server.handleClient();

  // ===== WiFi индикатор (ДОБАВЛЕНО) =====
  if (millis() - wifiTimer >= WIFI_CHECK_INTERVAL) {
    wifiTimer = millis();

    if (WiFi.status() == WL_CONNECTED) {
      digitalWrite(LED, LOW);   // подключено — горит
    } else {
      for(int i=0;i<3;i++){
        digitalWrite(LED, LOW); delay(200);
        digitalWrite(LED, HIGH); delay(200);
      }
    }
  }
}