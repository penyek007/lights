const char SW_JS[] PROGMEM = R"====(
const CACHE_NAME = "lights-cache-v3";

const URLS_TO_CACHE = [
  "/",
  "/manifest.json",
  "https://raw.githubusercontent.com/penyek007/lights/main/icon-512.png",
  "https://raw.githubusercontent.com/penyek007/lights/main/favicon.ico",
